# Copy to .env.local and fill in. Never commit real values.
# All variables are server-side only. None use the NEXT_PUBLIC_ prefix.

# Google OAuth client for sign-in only (basic profile scopes).
# Gmail access uses each user's app password, entered in Settings, not these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which AI service classifies email: "gemini" or "openrouter" (default).
AI_PROVIDER=gemini
# Optional: minimum gap between AI requests in ms (defaults suit each free tier).
# AI_MIN_INTERVAL_MS=4100

# Google Gemini (https://aistudio.google.com/apikey). Needed when AI_PROVIDER=gemini.
# Free tier: prompts (email text) may be used to improve Google's products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter (https://openrouter.ai/keys). Needed when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# A model ID from https://openrouter.ai/models that supports structured outputs.
OPENROUTER_MODEL=
# "true" lets providers keep or train on prompts, which contain email text.
# OpenRouter's free (:free) models require it. Default: false (private providers only).
OPENROUTER_ALLOW_DATA_COLLECTION=false

# MongoDB. Include the database name in the path, e.g. mongodb+srv://user:pass@cluster/mailbrain
MONGODB_URI=

# BetterAuth. Secret: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Encrypts users' Gmail app passwords at rest. Must be a base64-encoded 32-byte key.
# Changing it without the rotation steps below makes stored app passwords unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Key rotation: 1) move the current key here and put a new one in TOKEN_ENCRYPTION_KEY,
# 2) restart (the log says "Key rotation: N app password(s) re-encrypted"),
# 3) once every instance has restarted, clear this variable. Leave empty otherwise.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Automatic new-email processing (optional). Users still switch it on per mailbox in Settings.
# Local or self-hosted: run it in-process every N minutes.
AUTO_PROCESS_INTERVAL_MINUTES=5
# Serverless: a cron scheduler calls GET /api/cron/process-new-mail with "Authorization: Bearer <CRON_SECRET>".
# At least 32 characters. Leave empty to keep the route off.
CRON_SECRET=

# SMTP for MailBrain's own transactional email (optional until ROADMAP Phase 12). Set all four or none.
# This is the app's sender account, not a user's mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
